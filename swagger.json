  "components": {
    "schemas": {
      "ClienteDTO": {
        "required": [
          "cpfCnpj",
          "nome",
          "tipo"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "nome": {
            "type": "string"
          },
          "tipo": {
            "type": "string",
            "enum": [
              "FISICA",
              "JURIDICA"
            ]
          },
          "cpfCnpj": {
            "type": "string"
          },
          "dataNascimento": {
            "type": "string",
            "format": "date"
          },
          "estadoCivil": {
            "type": "string",
            "enum": [
              "SOLTEIRO",
              "CASADO",
              "VIUVO",
              "UNIAO_ESTAVEL",
              "DIVORCIADO"
            ]
          },
          "sexo": {
            "type": "string",
            "enum": [
              "MASCULINO",
              "FEMININO",
              "NEUTRO"
            ]
          },
          "profissao": {
            "type": "string"
          },
          "telefone": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "cep": {
            "type": "string"
          },
          "logradouro": {
            "type": "string"
          },
          "numero": {
            "type": "string"
          },
          "complemento": {
            "type": "string"
          },
          "bairro": {
            "type": "string"
          },
          "cidade": {
            "type": "string"
          },
          "uf": {
            "type": "string"
          }
        }
      },
      "UsuarioDTO": {
        "required": [
          "email",
          "nome",
          "perfil"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "nome": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "senha": {
            "type": "string"
          },
          "perfil": {
            "type": "string",
            "enum": [
              "ADMIN",
              "ADVOGADO",
              "SECRETARIA"
            ]
          },
          "oab": {
            "type": "string"
          },
          "ativo": {
            "type": "boolean"
          }
        }
      },
      "TarefaDTO": {
        "required": [
          "dataVencimento",
          "descricao",
          "usuarioId"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "descricao": {
            "type": "string"
          },
          "dataVencimento": {
            "type": "string",
            "format": "date"
          },
          "concluida": {
            "type": "boolean"
          },
          "tipo": {
            "type": "string",
            "enum": [
              "DILIGENCIA",
              "PRAZO",
              "CONTATO"
            ]
          },
          "usuarioId": {
            "type": "string",
            "format": "uuid"
          },
          "processoId": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "ProcessoDTO": {
        "required": [
          "clienteId",
          "numeroCnj"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "numeroCnj": {
            "type": "string"
          },
          "assunto": {
            "type": "string"
          },
          "faseAtual": {
            "type": "string"
          },
          "dataCriacao": {
            "type": "string",
            "format": "date"
          },
          "clienteId": {
            "type": "string",
